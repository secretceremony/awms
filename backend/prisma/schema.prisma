// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_LOGISTICS
  USER
}

enum TrackingType {
  SERIALIZED
  BULK
}

enum MaterialType {
  MAIN_MATERIAL
  CONSUMABLE
  TOOLS
  HSE_MATERIAL
}



enum MovementType {
  INITIAL
  INCOMING
  OUTGOING
  RETURN
  ADJUSTMENT
}

enum OrderStatus {
  DRAFT
  ISSUED
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ClientType {
  PHM
  OTHER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements        StockMovement[]
  createdDeliveryOrders DeliveryOrder[] @relation("doCreatedBy")
  issuedDeliveryOrders  DeliveryOrder[] @relation("doIssuedBy")
  shippingLabels        ShippingLabel[]
  auditLogs             AuditLog[]

  @@map("users")
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  symbol    String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@map("units")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cities")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  city      String
  cityCode  String   @map("city_code")
  location  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  warehouseStocks           WarehouseStock[]
  sourceStockMovements      StockMovement[]  @relation("sourceWarehouseRelation")
  destinationStockMovements StockMovement[]  @relation("destinationWarehouseRelation")
  deliveryOrders            DeliveryOrder[]
  itemSerials               ItemSerial[]     @relation("ItemSerialCurrentWarehouse")

  @@map("warehouses")
}

model Client {
  id         Int        @id @default(autoincrement())
  name       String     // Company Name
  clientType ClientType @default(OTHER) @map("client_type")
  phone      String?
  email      String?
  address    String?
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  contacts       ClientContact[]
  projects       Project[]
  deliveryOrders DeliveryOrder[]

  @@map("customers")
}

model ClientContact {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@index([clientId])
  @@map("client_contacts")
}

model Project {
  id              Int            @id @default(autoincrement())
  name            String
  referenceNumber String?        @map("reference_number")
  location        String
  siteCode        String?        @map("site_code")
  status          ProjectStatus  @default(ACTIVE)
  startedAt       DateTime?      @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  clientId        Int            @map("customer_id")
  client          Client         @relation(fields: [clientId], references: [id])
  clientContactId Int?           @map("client_contact_id")
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  projectStocks  ProjectStock[]
  stockMovements StockMovement[]
  deliveryOrders DeliveryOrder[]
  itemSerials    ItemSerial[] @relation("ItemSerialCurrentProject")

  @@index([clientId])
  @@index([clientContactId])
  @@map("projects")
}

model Item {
  id           Int          @id @default(autoincrement())
  name         String
  brand        String?
  modelNumber  String?      @map("model_number")
  unitId       Int          @map("unit_id")
  unit         Unit         @relation(fields: [unitId], references: [id])
  trackingType TrackingType @map("tracking_type")
  materialType MaterialType? @default(MAIN_MATERIAL) @map("material_type")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  itemSerials        ItemSerial[]
  warehouseStocks    WarehouseStock[]
  projectStocks      ProjectStock[]
  stockMovementItems StockMovementItem[]
  deliveryOrderItems DeliveryOrderItem[]

  @@index([unitId])
  @@map("items")
}

model ItemSerial {
  id                 Int        @id @default(autoincrement())
  serialNumber       String     @unique @map("serial_number")
  itemId             Int        @map("item_id")
  item               Item       @relation(fields: [itemId], references: [id])
  state              String     @default("STANDBY_GOOD")
  conditionLabel     String?    @map("condition_label")
  currentWarehouseId Int?       @map("current_warehouse_id")
  currentWarehouse   Warehouse? @relation("ItemSerialCurrentWarehouse", fields: [currentWarehouseId], references: [id])
  currentProjectId   Int?       @map("current_project_id")
  currentProject     Project?   @relation("ItemSerialCurrentProject", fields: [currentProjectId], references: [id])
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  movementSerials          StockMovementItemSerial[]
  deliveryOrderItemSerials DeliveryOrderItemSerial[]

  @@index([itemId])
  @@index([currentWarehouseId])
  @@index([currentProjectId])
  @@map("item_serials")
}

model WarehouseStock {
  id          Int       @id @default(autoincrement())
  warehouseId Int       @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  itemId      Int       @map("item_id")
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([warehouseId, itemId])
  @@index([itemId])
  @@map("warehouse_stocks")
}

model ProjectStock {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  itemId    Int      @map("item_id")
  item      Item     @relation(fields: [itemId], references: [id])
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, itemId])
  @@index([itemId])
  @@map("project_stocks")
}

model StockMovement {
  id                     Int          @id @default(autoincrement())
  movementNumber         String       @unique @map("movement_number")
  movementType           MovementType @map("movement_type")
  referenceNumber        String?      @map("reference_number")
  sourceWarehouseId      Int?         @map("source_warehouse_id")
  sourceWarehouse        Warehouse?   @relation("sourceWarehouseRelation", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId Int?         @map("destination_warehouse_id")
  destinationWarehouse   Warehouse?   @relation("destinationWarehouseRelation", fields: [destinationWarehouseId], references: [id])
  projectId              Int?         @map("project_id")
  project                Project?     @relation(fields: [projectId], references: [id])
  movementDate           DateTime     @default(now()) @map("movement_date")
  notes                  String?
  createdById            Int          @map("created_by_id")
  createdBy              User         @relation(fields: [createdById], references: [id])
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  items         StockMovementItem[]
  deliveryOrder DeliveryOrder?

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([projectId])
  @@index([createdById])
  @@map("stock_movements")
}

model StockMovementItem {
  id              Int           @id @default(autoincrement())
  stockMovementId Int           @map("stock_movement_id")
  stockMovement   StockMovement @relation(fields: [stockMovementId], references: [id])
  itemId          Int           @map("item_id")
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Int
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  movementSerials StockMovementItemSerial[]

  @@index([stockMovementId])
  @@index([itemId])
  @@map("stock_movement_items")
}

model StockMovementItemSerial {
  id                  Int               @id @default(autoincrement())
  stockMovementItemId Int               @map("stock_movement_item_id")
  stockMovementItem   StockMovementItem @relation(fields: [stockMovementItemId], references: [id])
  itemSerialId        Int               @map("item_serial_id")
  itemSerial          ItemSerial        @relation(fields: [itemSerialId], references: [id])
  createdAt           DateTime          @default(now()) @map("created_at")

  @@unique([stockMovementItemId, itemSerialId])
  @@index([itemSerialId])
  @@map("stock_movement_item_serials")
}

model DeliveryOrder {
  id                Int         @id @default(autoincrement())
  doNumber          String?     @unique @map("do_number")
  date              DateTime
  activity          String      @default("General Dispatch")
  notes             String?
  status            OrderStatus @default(DRAFT)
  issuedAt          DateTime?   @map("issued_at")
  issuedById        Int?        @map("issued_by_id")
  issuedBy          User?       @relation("doIssuedBy", fields: [issuedById], references: [id])
  clientId          Int         @map("customer_id")
  client            Client      @relation(fields: [clientId], references: [id])
  projectId         Int         @map("project_id")
  project           Project     @relation(fields: [projectId], references: [id])
  sourceWarehouseId Int         @map("source_warehouse_id")
  sourceWarehouse   Warehouse   @relation(fields: [sourceWarehouseId], references: [id])
  createdById       Int         @map("created_by_id")
  createdBy         User        @relation("doCreatedBy", fields: [createdById], references: [id])
  stockMovementId   Int?        @unique @map("stock_movement_id")
  stockMovement     StockMovement? @relation(fields: [stockMovementId], references: [id])

  // Historical Snapshot Fields
  clientCompanyName String?   @map("client_company_name")
  clientType        String?   @map("client_type")
  attnName          String?   @map("attn_name")
  attnPhone         String?   @map("attn_phone")
  attnEmail         String?   @map("attn_email")
  projectName       String?   @map("project_name")
  projectLocation   String?   @map("project_location")
  siteCode          String?   @map("site_code")
  referenceNumber   String?   @map("reference_number")
  warehouseName     String?   @map("warehouse_name")
  warehouseCityCode String?   @map("warehouse_city_code")
  snapshots         Json?

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  items             DeliveryOrderItem[]
  shippingLabels    ShippingLabel[]

  @@index([clientId])
  @@index([projectId])
  @@index([sourceWarehouseId])
  @@index([createdById])
  @@index([issuedById])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              Int           @id @default(autoincrement())
  deliveryOrderId Int           @map("delivery_order_id")
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  itemId          Int           @map("item_id")
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Int
  pic             String?
  remarks         String?

  // Snapshot attributes
  itemName        String?       @map("item_name")
  brand           String?
  modelNumber     String?       @map("model_number")
  unitName        String?       @map("unit_name")
  unitSymbol      String?       @map("unit_symbol")
  trackingType    TrackingType? @map("tracking_type")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  itemSerials     DeliveryOrderItemSerial[]

  @@index([deliveryOrderId])
  @@index([itemId])
  @@map("delivery_order_items")
}

model DeliveryOrderItemSerial {
  id                  Int               @id @default(autoincrement())
  deliveryOrderItemId Int               @map("delivery_order_item_id")
  deliveryOrderItem   DeliveryOrderItem @relation(fields: [deliveryOrderItemId], references: [id], onDelete: Cascade)
  itemSerialId        Int               @map("item_serial_id")
  itemSerial          ItemSerial        @relation(fields: [itemSerialId], references: [id])
  serialNumber        String?           @map("serial_number")
  conditionLabel      String?           @map("condition_label")
  createdAt           DateTime          @default(now()) @map("created_at")

  @@unique([deliveryOrderItemId, itemSerialId])
  @@index([itemSerialId])
  @@map("delivery_order_item_serials")
}

model ShippingLabel {
  id              Int            @id @default(autoincrement())
  deliveryOrderId Int?           @map("delivery_order_id")
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  sourceType      String         @default("STANDALONE") @map("source_type")
  shipDate        DateTime       @default(now()) @map("ship_date")
  recipientName   String         @map("recipient_name")
  attnName        String?        @map("attn_name")
  destination     String
  referenceNumber String?        @map("reference_number")
  doNumber        String?        @map("do_number")
  senderName      String?        @map("sender_name")
  senderAddress   String?        @map("sender_address")
  senderPhone     String?        @map("sender_phone")
  isFragile       Boolean        @default(false) @map("is_fragile")
  handlingNote    String?        @map("handling_note")
  labelWidth      Int?           @default(100) @map("label_width")
  labelHeight     Int?           @default(150) @map("label_height")
  notes           String?
  createdById     Int?           @map("created_by_id")
  createdBy       User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([deliveryOrderId])
  @@index([createdById])
  @@map("shipping_labels")
}

model DoSequence {
  id              Int      @id @default(autoincrement())
  year            Int      @unique
  currentSequence Int      @default(0) @map("current_sequence")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("do_sequences")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityName String   @map("entity_name")
  entityId   Int?     @map("entity_id")
  payload    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}
